{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NavIC-Restore API Contracts",
  "version": "1.0.0",
  "description": "Shared JSON schemas and API contracts for Team Hypervisors (ASTRA 2026 Overnight Hackathon).",
  "definitions": {
    "Coordinate2D": {
      "type": "object",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["lat", "lon"]
    },
    "Coordinate3D": {
      "type": "object",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "elevation_m": { "type": "number" },
        "height_m": { "type": "number", "default": 0 }
      },
      "required": ["lat", "lon"]
    },
    "ScenarioMetadata": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": "string" },
        "state": { "type": "string" },
        "description": { "type": "string" },
        "terrain_type": { "type": "string", "enum": ["mountain_canyon", "river_floodplain", "urban_valley", "coastal"] },
        "center": { "$ref": "#/definitions/Coordinate2D" },
        "bounding_box": {
          "type": "object",
          "properties": {
            "min_lat": { "type": "number" },
            "max_lat": { "type": "number" },
            "min_lon": { "type": "number" },
            "max_lon": { "type": "number" }
          },
          "required": ["min_lat", "max_lat", "min_lon", "max_lon"]
        },
        "sar_source": { "type": "string", "default": "EOS-04 C-band SAR (Bhoonidhi NRSC)" },
        "dem_source": { "type": "string", "default": "Cartosat-1 DEM 30m (Bhuvan NRSC)" },
        "benchmark_reference": { "type": "string" }
      },
      "required": ["id", "name", "region", "terrain_type", "center", "bounding_box"]
    },
    "FloodCell": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "elevation_m": { "type": "number" },
        "flood_depth_m": { "type": "number" },
        "is_flooded": { "type": "boolean" },
        "passable_type": {
          "type": "string",
          "enum": ["dry", "ambulance_passable", "boat_only", "deep_flood"]
        },
        "horizon_mask_deg": { "type": "number", "minimum": 0, "maximum": 90 }
      },
      "required": ["lat", "lon", "elevation_m", "flood_depth_m", "is_flooded", "passable_type"]
    },
    "DryRidge": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "elevation_m": { "type": "number" },
        "height_above_flood_m": { "type": "number" },
        "recommended_tether_height_m": { "type": "number", "default": 50 },
        "is_recommended": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "lat", "lon", "elevation_m", "height_above_flood_m"]
    },
    "RescueChannel": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "channel_type": { "type": "string", "enum": ["ambulance", "boat", "aerial_tether"] },
        "max_depth_m": { "type": "number" },
        "avg_depth_m": { "type": "number" },
        "waypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lon": { "type": "number" },
              "depth_m": { "type": "number" }
            },
            "required": ["lat", "lon", "depth_m"]
          }
        }
      },
      "required": ["id", "name", "channel_type", "waypoints"]
    },
    "DopGridRequest": {
      "type": "object",
      "properties": {
        "scenario_id": { "type": "string" },
        "timestamp_iso": { "type": "string" },
        "active_satellites": { "type": "array", "items": { "type": "string" } },
        "mode": { "type": "string", "enum": ["baseline", "pseudolite", "barometer"] },
        "beacon": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lon": { "type": "number" },
            "elevation_m": { "type": "number" },
            "height_m": { "type": "number", "minimum": 10, "maximum": 150 }
          },
          "required": ["lat", "lon", "height_m"]
        },
        "uere_m": { "type": "number", "default": 3.0, "minimum": 1.0, "maximum": 10.0 }
      },
      "required": ["scenario_id", "mode"]
    },
    "OptimizeBeaconRequest": {
      "type": "object",
      "properties": {
        "scenario_id": { "type": "string" },
        "timestamp_iso": { "type": "string" },
        "active_satellites": { "type": "array", "items": { "type": "string" } },
        "min_dist_m": { "type": "number", "default": 200 },
        "max_dist_m": { "type": "number", "default": 15000 },
        "beacon_height_m": { "type": "number", "default": 50, "minimum": 10, "maximum": 150 },
        "uere_m": { "type": "number", "default": 3.0 }
      },
      "required": ["scenario_id"]
    },
    "Timeseries24hRequest": {
      "type": "object",
      "properties": {
        "scenario_id": { "type": "string" },
        "point": { "$ref": "#/definitions/Coordinate2D" },
        "beacon": { "$ref": "#/definitions/Coordinate3D" },
        "uere_m": { "type": "number", "default": 3.0 }
      },
      "required": ["scenario_id", "point"]
    }
  }
}
